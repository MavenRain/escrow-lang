diff --git a/dev/surface-branch-test.py b/dev/surface-branch-test.py
new file mode 100644
index 0000000..23e002a
--- /dev/null
+++ b/dev/surface-branch-test.py
@@ -0,0 +1,199 @@
+#!/usr/bin/env python3
+"""Check surface tail branches: guard pairs, nested legs, leg step scans and refusals."""
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+
+import sys
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import native_mutations
+import shutil
+import subprocess
+import sys
+import tempfile
+
+ROOT = Path(__file__).resolve().parent.parent
+WORK = ROOT / '.gatework/surface-branch'
+spec = importlib.util.spec_from_file_location('core_context', ROOT / 'dev/context-test.py')
+C = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(C)
+C.WORK = WORK
+require = C.require
+FILES = ('runtime.hex', 'init.hex', 'abi.json', 'layout.json', 'axioms.txt')
+
+
+def single(body, extra='', init='sstore limit (word 9) ;'):
+    return f'''contract SingleBranch where
+  storage State := {{ cell : Word ; limit : Word }}
+  {extra}
+  entry keep (x : Word) : Eff Sig Word := do
+    {body}
+  constructor := do {init} pure ()
+'''
+
+
+def pair_cases():
+    return [
+        ('guard-tail', 'lim <- sload limit ; guard le x lim ; sstore cell x ; pure x',
+         'lim <- sload limit ; if le x lim then sstore cell x ; pure x else revert'),
+        ('guard-leg', 'lim <- sload limit ; if le x lim then guard le x (word 3) ; sstore cell x ; pure x else pure (word 0)',
+         'lim <- sload limit ; if le x lim then if le x (word 3) then sstore cell x ; pure x else revert else pure (word 0)'),
+    ]
+
+
+def pairs():
+    checked = 0
+    for name, guarded, branched in pair_cases():
+        _path, guard_out, _runtime = C.emit(name + '-guard', single(guarded))
+        _path, branch_out, _runtime = C.emit(name + '-branch', single(branched))
+        for file in FILES:
+            require((guard_out / file).read_bytes() == (branch_out / file).read_bytes(),
+                    'SURFACE-BRANCH-PAIR ' + name + ' ' + file)
+        checked += 1
+    return checked
+
+
+def calldata(name, *argv):
+    return json.loads(C.checked('calldata-' + name, [C.BINARY, 'calldata-encode', *argv]))['calldata']
+
+
+def outcome(name, path, runtime, data, caller, want, slots, marker):
+    argv = [C.BINARY, 'run', path, '--calldata', data, '--caller', hex(caller)]
+    for slot, stored in slots.items():
+        argv += ['--storage', f'{int(slot, 16)}={int(stored, 16)}']
+    model = json.loads(C.checked('model-' + name, argv))
+    actual, _ = C.evm_run(name, runtime, data, caller, slots=slots)
+    require(model == want, marker + '-MODEL ' + name)
+    require(actual == want, marker + '-EVM ' + name)
+
+
+def word(value):
+    return f'0x{value:064x}'
+
+
+def live():
+    path, output, runtime = C.emit('settle', (ROOT / 'examples/SurfaceBranch.asy').read_text())
+    abi = json.loads((output / 'abi.json').read_text())
+    require({row['name']: row['stateMutability'] for row in abi if row['type'] == 'function'} == dict(settle='nonpayable'),
+            'SURFACE-BRANCH-ABI')
+    cases = 0
+    for bonus in (0, 5, 2**255):
+        data = calldata(f'settle-{bonus}', 'settle', 'uint256', str(bonus))
+        for verdict in (0, 1, 2, 3, 2**256 - 1):
+            for caller in (0, C.SENDER):
+                name = f'settle-{bonus}-{verdict}-{caller:x}'
+                before = {'1': '0x64', **({'0': hex(verdict)} if verdict else {})}
+                legs = {
+                    1: (word(100 + bonus), {**before, '1': hex(100 + bonus)}),
+                    0: (word(0), {**before, **({'2': hex(caller)} if caller else {})}),
+                    2: (word(2), before),
+                }
+                result, storage = legs.get(verdict, ('0x', before))
+                status = 'success' if verdict in legs else 'revert'
+                want = dict(status=status, output=result, storage=storage)
+                outcome(name, path, runtime, data, caller, want, before, 'SURFACE-BRANCH')
+                cases += 1
+    return cases
+
+
+def scan():
+    source = single('if le x (word 5) then sender <- caller ; pure sender else pure (word 0)')
+    path, output = WORK / 'scan.asy', WORK / 'scan'
+    path.write_text(source)
+    emitted = C.capture('emit-scan', [C.BINARY, 'emit', path, '-o', output])
+    require(emitted.returncode == 0, 'SURFACE-BRANCH-SCAN emit: ' + emitted.stderr)
+    runtime = (output / 'runtime.hex').read_text().strip().removeprefix('0x')
+    abi = json.loads((output / 'abi.json').read_text())
+    require([row['stateMutability'] for row in abi if row['type'] == 'function'] == ['view'], 'SURFACE-BRANCH-SCAN abi')
+    cases = 0
+    for x, caller in ((1, 0x42), (5, C.SENDER), (6, 0x42), (2**256 - 1, C.SENDER)):
+        data = calldata(f'scan-{x}', 'keep', 'uint256', str(x))
+        want = dict(status='success', output=word(caller if x <= 5 else 0), storage={'1': '0x9'})
+        outcome(f'scan-{x}', path, runtime, data, caller, want, {'1': '0x9'}, 'SURFACE-BRANCH-SCAN')
+        cases += 1
+    return cases
+
+
+def negative_cases():
+    return [
+        ('trailing', single('if le x (word 1) then pure x else pure (word 2) ; pure x'), 'SURFACE_BRANCH'),
+        ('nested-trailing', single('if le x (word 1) then if le x (word 0) then pure x else pure x ; pure x else pure x'),
+         'SURFACE_BRANCH'),
+        ('not-le', single('if x then pure x else pure (word 2)'), 'SURFACE_BRANCH'),
+        ('missing-else', single('if le x (word 1) then pure x'), 'SURFACE_SYNTAX'),
+        ('constructor', single('pure x', init='if le (word 1) (word 2) then pure () else pure () ;'), 'SURFACE_BRANCH'),
+        ('leg-scope', single('if le x (word 1) then sender <- caller ; pure sender else pure sender'), 'SURFACE_SCOPE'),
+        ('reserved-field', single('pure x').replace('cell : Word', 'else : Word'), 'SURFACE_NAME'),
+        ('reserved-binding', single('then <- caller ; pure then'), 'SURFACE_NAME'),
+    ]
+
+
+def refusals(only=None):
+    rows = negative_cases()
+    require(only is None or only in {name for name, _source, _marker in rows},
+            'SURFACE-BRANCH-REFUSAL unknown ' + str(only))
+    checked = 0
+    for name, source, marker in rows:
+        if only is not None and name != only:
+            continue
+        path = WORK / (name + '.asy')
+        path.write_text(source)
+        output = WORK / (name + '-out')
+        for command in (['check', path], ['emit', path, '-o', output], ['run', path, '--calldata', '0x']):
+            result = C.capture(name + '-' + command[0], [C.BINARY, *command])
+            require(result.returncode == 1 and marker in result.stdout + result.stderr and not output.exists(),
+                    'SURFACE-BRANCH-REFUSAL ' + name + ' ' + command[0])
+        checked += 1
+    return checked
+
+
+def mutants():
+    cases = native_mutations.load(__file__)
+    records = []
+    with tempfile.TemporaryDirectory(prefix='assay-surface-branch-mutants-') as temporary:
+        copy = Path(temporary) / 'copy'
+        native_mutations.copy_project(ROOT, copy)
+        path = copy / 'src/emitter.bend'
+        original = path.read_text()
+        for name, before, after, witness, marker in cases:
+            require(native_mutations.count(original, before) == 1, 'SURFACE-BRANCH-MUTANT anchor ' + name)
+            for mutated in (True, False):
+                path.write_text(native_mutations.replace(original, before, after) if mutated else original)
+                label = ('mutant-' if mutated else 'control-') + name
+                build = C.capture(label + '-build', ['zsh', '-f', 'dev/build.sh', 'build', 'bin/assay'], cwd=copy, timeout=120)
+                require(build.returncode == 0, 'SURFACE-BRANCH-MUTANT build ' + label)
+                result = C.capture(label, ['python3', '-P', 'dev/surface-branch-test.py', witness], cwd=copy, timeout=180)
+                require(result.returncode == (1 if mutated else 0) and (not mutated or marker in result.stdout),
+                        'SURFACE-BRANCH-MUTANT witness ' + label)
+                records.append(dict(name=label, exit=result.returncode, marker=marker,
+                                    source_sha256=hashlib.sha256(path.read_bytes()).hexdigest()))
+            print('SURFACE-BRANCH-MUTANT ' + name + ' killed control=OK', flush=True)
+    C.save('MUTANTS', records)
+    return len(cases)
+
+
+def main():
+    commands = dict(live=live, pairs=pairs, scan=scan, refusals=refusals, mutants=mutants,
+                    trailing=lambda: refusals('trailing'))
+    if sys.argv[1:] and sys.argv[1:] not in [[name] for name in commands]:
+        return 64
+    shutil.rmtree(WORK, ignore_errors=True)
+    WORK.mkdir(parents=True, exist_ok=True)
+    if sys.argv[1:]:
+        result = commands[sys.argv[1]]()
+        print(f'SURFACE-BRANCH {sys.argv[1]} {result} OK', flush=True)
+    else:
+        cases, paired, scanned = live(), pairs(), scan()
+        invalid, killed = refusals(), mutants()
+        print(f'SURFACE-BRANCH cases={cases} pairs={paired} scan={scanned} refusals={invalid} mutants={killed} OK',
+              flush=True)
+    return 0
+
+
+if __name__ == '__main__':
+    try:
+        sys.exit(main())
+    except (OSError, ValueError, subprocess.SubprocessError) as error:
+        print('SURFACE-BRANCH FAIL ' + str(error), flush=True)
+        sys.exit(1)
