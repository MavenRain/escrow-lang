diff --git a/examples/SurfaceBranch.asy b/examples/SurfaceBranch.asy
new file mode 100644
index 0000000..4e85bd9
--- /dev/null
+++ b/examples/SurfaceBranch.asy
@@ -0,0 +1,15 @@
+contract SurfaceBranch where
+  storage State := { verdict : Word ; ledger : Word ; last : Word }
+  entry settle (bonus : Word) : Eff Sig Word := do
+    d <- sload verdict ;
+    if le d (word 1) then
+      if le (word 1) d then
+        b <- sload ledger ; c <- add b bonus ; sstore ledger c ; pure c
+      else
+        sender <- caller ; sstore last sender ; pure (word 0)
+    else
+      if le d (word 2) then
+        pure (word 2)
+      else
+        revert
+  constructor := do sstore ledger (word 100) ; pure ()
